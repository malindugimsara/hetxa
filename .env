# ==============================================================================
# HETXA BOS - ENVIRONMENT CONFIGURATION (.env)
# Store sensitive credentials here. NEVER commit this file to public repositories.
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false

# ------------------------------------------------------------------------------
# 1. LEAD NOTIFICATION RECIPIENTS
# ------------------------------------------------------------------------------
ADMIN_EMAIL=hello@hetxa.com
BACKUP_EMAIL=sales@hetxa.com
SENDER_NAME="Hetxa BOS Lead System"
SENDER_EMAIL=hello@hetxa.com

# WhatsApp Hotline (International format without + e.g. 94774341227)
WHATSAPP_HOTLINE=94774341227

# ------------------------------------------------------------------------------
# 2. SMTP MAIL SERVER CREDENTIALS
# ------------------------------------------------------------------------------
# Set USE_SMTP=true to enable authenticated SMTP via PHPMailer
# Set USE_SMTP=true to use default server mail() function
USE_SMTP=true

# SMTP Server Details (cPanel Webmail or Gmail / Google Workspace)
# For cPanel Webmail: SMTP_HOST=mail.hetxa.com, Port=465 (ssl) or 587 (tls)
# For Gmail / Workspace: SMTP_HOST=smtp.gmail.com, Port=465 (ssl) or 587 (tls)
SMTP_HOST=mail.hetxa.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=hello@hetxa.com
SMTP_PASS=")]%Ac~s&E-QZ54n6"

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE TURNSTILE (ANTI-SPAM CAPTCHA)
# ------------------------------------------------------------------------------
# Replace with your live Site Key & Secret Key from Cloudflare Dashboard -> Turnstile.
# Current keys are Cloudflare's official Always-Passes test keys for local testing.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

